{
  "ConnectionStrings:Headhunter": "Server=localhost;Database=Headhunter;Trusted_Connection=True;Encrypt=False;",
  // Console (compact JSON) and, when OTEL_EXPORTER_OTLP_ENDPOINT is set, OTLP are added in code
  // (Telemetry/LoggingExtensions.cs). Sinks added here come on top; do not add Console, it would print twice.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Headhunter": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    }
  },
  "HealthChecks": {
    "Path": "/health",
    "LivePath": "/health/live",
    "ReadyPath": "/health/ready",
    // Managed memory above this reports Degraded. Size it below the container's memory limit.
    "MaxAllocatedMegabytes": 384
  },
  "ForwardedHeaders": {
    // Fetch Cloudflare's published ranges at startup and trust them, to walk X-Forwarded-For past the
    // Cloudflare edge. Off: behind Traefik, X-Real-IP already carries the client.
    "FetchCloudflare": false,
    "CloudflareIpsV4Url": "https://www.cloudflare.com/ips-v4/",
    "CloudflareIpsV6Url": "https://www.cloudflare.com/ips-v6/"
  },
  "AllowedHosts": "*"
}
